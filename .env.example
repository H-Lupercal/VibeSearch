# Optional API key; leave blank for public requests.
VIBESEARCH_API_KEY=
# Provide a working operator contact address or project URL before collection.
VIBESEARCH_USER_AGENT_CONTACT=
VIBESEARCH_API_ORIGIN=https://nhentai.net
VIBESEARCH_EMBEDDING_MODEL=BAAI/bge-m3
VIBESEARCH_EMBEDDING_DEVICE=auto
VIBESEARCH_EMBEDDING_BATCH_SIZE=8
VIBESEARCH_DISPLAY_MODE=full
# VIBESEARCH_DATA_DIR=/absolute/path/to/data
# Optional immutable commit hash, recorded in each embedding contract.
# VIBESEARCH_EMBEDDING_REVISION=

# Local single-worker web UI. Stop serve before other data-directory commands.
VIBESEARCH_WEB_HOST=127.0.0.1
VIBESEARCH_WEB_PORT=8000
VIBESEARCH_ALLOW_NON_LOOPBACK=false
VIBESEARCH_EMBED_QUEUE_SIZE=8
VIBESEARCH_EMBED_QUEUE_TIMEOUT_S=30
# MB denotes MiB here; TTL starts at fetch completion, not last access.
VIBESEARCH_IMAGE_CACHE_MAX_MB=512
VIBESEARCH_IMAGE_CACHE_TTL_HOURS=24
VIBESEARCH_REFRESH_MAX_ITEMS_DEFAULT=50
# Translation remains deferred in v2.0; no implicit cloud calls.
VIBESEARCH_TITLE_TRANSLATOR=none
VIBESEARCH_PAGE_TRANSLATOR=none
